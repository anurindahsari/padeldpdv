rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['a.nurindahsari@gmail.com'];
    }
    function isOpen() { return request.time < timestamp.value(1794329999000); }
    function isOwnerNew() { return request.auth != null && request.resource.data.owner == request.auth.uid; }
    function isOwnerOld() { return request.auth != null && resource.data.owner == request.auth.uid; }

    match /daftar/{dpc} {
      allow read: if true;
      allow create: if isOpen() && isOwnerNew() && request.resource.data.dpc is string;
      allow update: if isAdmin() || (isOpen() && isOwnerOld() && isOwnerNew());
      allow delete: if isAdmin() || (isOpen() && isOwnerOld());
    }
    match /privat/{dpc} {
      allow read: if isAdmin() || isOwnerOld();
      allow create: if isOpen() && isOwnerNew();
      allow update: if isAdmin() || (isOpen() && isOwnerOld() && isOwnerNew());
      allow delete: if isAdmin() || (isOpen() && isOwnerOld());
    }
    match /foto/{id} {
      allow read: if true;
      allow create: if isOpen() && isOwnerNew() && request.resource.data.d.size() < 300000;
      allow update: if isAdmin() || (isOpen() && isOwnerOld() && isOwnerNew() && request.resource.data.d.size() < 300000);
      allow delete: if isAdmin() || (isOpen() && isOwnerOld());
    }
    match /panitia/{k} { allow get: if k == '8caf131174070313fb05a0f41bd60b6cd1750617'; allow list: if false; allow write: if k == '8caf131174070313fb05a0f41bd60b6cd1750617' && request.resource.data.rows is list && request.resource.data.rows.size() < 80; }
  }
}
